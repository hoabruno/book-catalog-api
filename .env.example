# Production secrets for docker-compose.yml. Generate them on the server
# (see README), never commit the real file.
APP_HOST=books.example.com
APP_KEY=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Garage key id: "GK" followed by 24 hex characters; secret: 64 hex characters.
BOOKS_S3_KEY=
BOOKS_S3_SECRET=
BOOKS_WEBDAV_PASSWORD=
